# 이 사이트는 정적으로 빌드된다. 아래 값들은 **빌드 시점에 결과물에 박힌다.**
# 배포 워크플로(.github/workflows)가 넣는다.

# ── 사이트 주소 ────────────────────────────────────────────────────────
# sitemap.xml · robots.txt · OG 태그의 절대 URL 에 쓰인다.
NEXT_PUBLIC_SITE_URL=

# GitHub Pages 프로젝트 페이지는 /<저장소명> 아래에 붙는다. 커스텀 도메인이면 비운다.
NEXT_PUBLIC_BASE_PATH=

# ── 서비스로 들어가는 문 ───────────────────────────────────────────────
# 실제 서비스(웹 앱) 주소. 비어 있으면 시작 버튼이 "출시 준비 중" 으로 잠긴다.
# 죽은 링크를 눌러 아무 일도 일어나지 않는 것보다 낫다.
NEXT_PUBLIC_APP_URL=

# 스토어 주소. 심사가 끝나면 채운다. 비어 있으면 해당 배지를 그리지 않는다.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# 문의처. 스토어 등록과 개인정보 처리방침이 모두 연락 수단을 요구한다.
# 비어 있으면 푸터에 문의 안내를 그리지 않는다 — 개인 메일을 기본값으로 박아 두지 않는다.
NEXT_PUBLIC_CONTACT_EMAIL=
